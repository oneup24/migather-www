# The works editor.
#
# These override the values in `src/data/cms.js`, which is where they
# normally live — the published build works without anybody configuring
# anything. Set them here only if you would rather keep the sheet id and
# the script address out of the repository.
#
# None of them is a secret: the client id is public by definition, and the
# sheet's own permissions are what protect the content.

# The OAuth client id. Its authorised JavaScript origins and redirect URIs
# must both include the site's origin.
VITE_CMS_CLIENT_ID=

# The Google Sheet that holds the case content.
VITE_CMS_SHEET_ID=

# The Apps Script that saves the pictures and asks GitHub to rebuild.
VITE_CMS_SCRIPT_URL=
