# The works editor.
#
# These are read by the build (Vite exposes VITE_-prefixed variables) and
# are used by the /admin page. None of them is a secret — the sheet's own
# sharing is what protects the content — but they are not in the repository
# either, so they are set per environment.
#
# Copy this to `.env.local` for local work, and set them as repository
# variables for the published build.

# The OAuth client id, from Google Cloud console → APIs & Services →
# Credentials → OAuth client ID → Web application. Its authorised
# JavaScript origins must include the site's origin.
VITE_CMS_CLIENT_ID=

# The Google Sheet that holds the case content.
VITE_CMS_SHEET_ID=

# The Apps Script that saves the pictures and asks GitHub to rebuild.
VITE_CMS_SCRIPT_URL=
